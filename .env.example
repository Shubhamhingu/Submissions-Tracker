# Copy this file to ".env" and fill in your values.
# ".env" is git-ignored -- never commit real secrets.

# --- required-ish ---------------------------------------------------------
# Long random string used to sign session cookies.
SECRET_KEY=change-me-to-something-random

# Login password hash. Generate with:
#   python manage.py set-password "your password"
# then paste the printed value here (it starts with "scrypt:" or "pbkdf2:").
APP_PASSWORD_HASH=

# --- Ask-the-data chatbot (optional) ------------------------------------
# The "Ask the data" tab only appears when this is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=            # only for Azure / an OpenAI-compatible proxy

# --- rarely needed -----------------------------------------------------
# DATABASE_URL=sqlite:///count_automation.db
# SUBMISSIONS_CSV=submissions.csv
